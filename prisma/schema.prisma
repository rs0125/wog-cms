// ⚠️  The BACKEND repo (WareOnGo-Website-Backend/prisma/schema.prisma) owns this
// database's schema. This file deliberately declares ONLY the tables the CMS
// touches, so the generated client cannot reach anything else.
//
// NEVER run `prisma db push`, `prisma db pull` or `prisma migrate` from this
// app. Pushing this partial schema would drop every table it omits. Schema
// changes go in the backend repo; mirror them here by hand afterwards.
//
// Safe to run here: `prisma generate`.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Mirror of the Blog model in the backend schema — keep in sync by hand.
model Blog {
  id            Int         @id @default(autoincrement())
  slug          String      @unique
  title         String
  seoTitle      String
  description   String
  summary       String
  keywords      String[]    @default([])
  blocks        Json
  faqs          Json
  related       String[]    @default([])
  /// Optional byline; null falls back to the WareOnGo organisation.
  author        String?
  datePublished DateTime?   @db.Date
  dateModified  DateTime    @db.Date
  sortOrder     Int         @default(0)
  /// Content as of the last triggered deploy; null if never deployed. Drives
  /// the Staged badge and the revert action.
  deployedContent Json?
  deployedAt      DateTime?
  status        BlogStatus @default(DRAFT)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, sortOrder])
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

/// Mirror of the MicromarketPage model in the backend schema — keep in sync by hand.
///
/// Editorial content for /overview/{state}/{citySlug}/{slug}. State is derived
/// from the backend's canonical city geography. Only PUBLISHED rows produce an
/// overview; existing micromarket listing URLs always render the plain grid.
model MicromarketPage {
  id               Int                   @id @default(autoincrement())
  citySlug         String
  slug             String
  /// Display name, for this CMS's list view only.
  name             String
  seoTitle         String
  metaDescription  String
  h1               String
  heroEyebrow      String?
  heroProse        String
  heroImage        Json?
  marketHeading    String?
  marketProse      String?
  marketImage      Json?
  rentsHeading     String?
  rentsProse       String?
  specHeading      String?
  specProse        String?
  inventoryHeading String?
  faqs             Json
  relatedBlogs     String[]              @default([])
  /// Manual corrections to the figures the website derives from live listings.
  /// Partial and optional — see the backend schema for the full contract, and
  /// lib/micromarket-schema.ts for the validated shape.
  statOverrides    Json?
  status           MicromarketPageStatus @default(DRAFT)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  /// Same contract as Blog.deployedContent — see lib/staging.ts.
  deployedAt       DateTime?
  deployedContent  Json?

  @@unique([citySlug, slug])
  @@index([status])
}

enum MicromarketPageStatus {
  DRAFT
  PUBLISHED
}

/// Which kind of location a LocationPage carries content for. Mirror of the
/// backend enum — keep in sync by hand.
enum LocationPageKind {
  CITY
  STATE
}

/// Editorial content for /overview/{state} and /overview/{state}/{city}.
/// Published rows use the shared wireframe. Listing URLs keep their grids.
///
/// One table with a discriminator rather than CityPage and StatePage: "delhi",
/// "puducherry" and "goa" are each both a city and a state in this catalogue,
/// which is why the unique key is the pair.
model LocationPage {
  id               Int                   @id @default(autoincrement())
  kind             LocationPageKind
  slug             String
  /// Display name, for this CMS's list view only.
  name             String
  seoTitle         String
  metaDescription  String
  h1               String
  heroEyebrow      String?
  heroProse        String
  heroImage        Json?
  marketHeading    String?
  marketProse      String?
  marketImage      Json?
  rentsHeading     String?
  rentsProse       String?
  specHeading      String?
  specProse        String?
  inventoryHeading String?
  faqs             Json
  relatedBlogs     String[]              @default([])
  /// Same contract as MicromarketPage.statOverrides — see the backend schema,
  /// and lib/location-schema.ts for the validated shape.
  statOverrides    Json?
  status           MicromarketPageStatus @default(DRAFT)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  /// Same contract as Blog.deployedContent — see lib/staging.ts.
  deployedAt       DateTime?
  deployedContent  Json?

  @@unique([kind, slug])
  @@index([status])
}
