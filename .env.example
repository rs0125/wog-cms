# Copy to .env and fill in. The same values are required in Vercel.

DATABASE_URL=postgresql://...          # same Supabase DB as the backend

# Shared with EmployeeReimbursementPortal — same OAuth client, one set of
# credentials to rotate. GOOGLE_REDIRECT_URI must be registered on that client
# in Google Cloud Console (it holds several: one per app/environment).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Comma-separated emails allowed into the CMS.
CMS_ALLOWED_EMAILS=you@wareongo.com

# Signs the session cookie. Required. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Cloudflare R2 — where guide images are stored, under the `guides/` prefix of
# the same bucket the backend writes warehouse photos to. Copy these from the
# backend's .env; the CMS only ever writes, never deletes.
#
# R2_PUBLIC_URL is the public host with no trailing slash. It has to be a host
# the website's vercel.json allows under images.remotePatterns (currently
# *.r2.dev) — otherwise Vercel's optimizer refuses the source and the page falls
# back to serving the full-size original.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Vercel Deploy Hook for the WEBSITE project (not this one). Vercel -> the
# wareongo-website project -> Settings -> Git -> Deploy Hooks -> branch `main`.
# The id in the URL is the credential; there is no auth header. Treat as a secret.
WEBSITE_DEPLOY_HOOK_URL=

