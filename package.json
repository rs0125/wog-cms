{
  "name": "wareongo-cms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:ai-writing": "node tests/ai-writing.test.mjs && node tests/ai-writing-schema.test.mjs",
    "test:blogs": "node --test tests/blog-thumbnails.test.mjs",
    "test:agent-cms": "node tests/agent-cms.test.mjs",
    "test:agent-cms:postgres": "node tests/agent-cms-postgres.test.mjs",
    "test:formatting": "node tests/formatting.test.mjs",
    "test:word-count": "node tests/word-count.test.mjs",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test:deploy": "node tests/deploy.test.mjs",
    "test:locations": "node tests/location-actions.test.mjs",
    "postinstall": "prisma generate",
    "test:legal": "node tests/legal-actions.test.mjs",
    "test:services": "node --test tests/service-actions.test.mjs",
    "test:ad-pages": "node --test tests/ad-page-actions.test.mjs tests/ad-page-content.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@prisma/client": "^6.16.2",
    "next": "16.3.0",
    "prisma": "^6.16.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
